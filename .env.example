# Copia este archivo como ".env" (ese si esta ignorado por git) y completa los valores.
# docker compose lee ".env" automaticamente.

# Aqui colocar la contrasena que quieras para PostgreSQL (se usa para crear el rol "gasmapocho").
DB_PASSWORD=

# Opcional: repo de configuracion que lee el config-server. Si no lo defines usa el del grupo en GitHub.
# CONFIG_REPO_URI=https://github.com/Sophia-1827/DAW-II_Grupo09_gasmapocho_config-repo

# Opcional: "native" = el config-server lee la carpeta ../config-repo local (sin push). Si no se define, lee GitHub.
# CONFIG_SERVER_PROFILE=native
